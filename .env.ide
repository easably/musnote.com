# Cloudflare (same account as docaichat / 5scontrol)
# Account ID = from dash URL: dash.cloudflare.com/<ACCOUNT_ID>/...
CLOUDFLARE_ACCOUNT_ID=cfc0266f9302eb966989ac53523b5c87
CLOUDFLARE_ZONE_ID_MUSNOTE=f987c1896bd2cd3f86cac9b3ce6000e8
CLOUDFLARE_PAGES_PROJECT=musnote
# Use token with Pages + Zone DNS Edit for musnote.com (docaichat-cloudflare-deploy sees zone;
# docaichat-cloudflare-ide does NOT include musnote zone — that caused the false "wrong account" scare)
# Token value lives in GitHub Actions secret CLOUDFLARE_API_TOKEN (from docaichat .env.ide)

GSC_PROPERTY_SITE_URL=sc-domain:musnote.com
DEFAULT_SITEMAP_URL=https://musnote.com/sitemap.xml
MUSNOTE_API_BASE=https://api.freedubbing.com
