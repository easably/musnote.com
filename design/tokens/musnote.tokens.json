{
  "$description": "MusNote tokens. Edit this file, then run node scripts/build-tokens.js. CSS and Dart are generated.",
  "mn": {
    "green": {
      "50": { "$type": "color", "$value": "#eefbf6" },
      "100": { "$type": "color", "$value": "#d5f5e9" },
      "200": { "$type": "color", "$value": "#a8e9d0" },
      "400": { "$type": "color", "$value": "#2fd39a" },
      "500": { "$type": "color", "$value": "#15c39a" },
      "600": { "$type": "color", "$value": "#0e9f6e" },
      "700": { "$type": "color", "$value": "#0b7a56" },
      "800": { "$type": "color", "$value": "#0a5c42" }
    },
    "ink": { "$type": "color", "$value": "#0f1f1a" },
    "ink-soft": { "$type": "color", "$value": "#3d4f48" },
    "muted": { "$type": "color", "$value": "#6b7c75" },
    "line": { "$type": "color", "$value": "#dce6e1" },
    "surface": { "$type": "color", "$value": "#ffffff" },
    "surface-2": { "$type": "color", "$value": "#f6faf8" },
    "wash": { "$type": "color", "$value": "#e8f6f0" },
    "focus": { "$type": "color", "$value": "#15c39a" },
    "danger": { "$type": "color", "$value": "#c23b3b" },
    "ok": { "$type": "color", "$value": "#0e9f6e" },
    "font-sans": { "$type": "fontFamily", "$value": ["Outfit", "Segoe UI", "sans-serif"] },
    "font-display": { "$type": "fontFamily", "$value": ["Source Serif 4", "Georgia", "serif"] },
    "fs-xs": { "$type": "dimension", "$value": "0.8125rem" },
    "fs-sm": { "$type": "dimension", "$value": "0.9375rem" },
    "fs-md": { "$type": "dimension", "$value": "1.0625rem" },
    "fs-lg": { "$type": "dimension", "$value": "1.25rem" },
    "fs-xl": { "$type": "dimension", "$value": "clamp(1.75rem, 3.5vw, 2.5rem)", "$extensions": { "flutter": { "min": 28, "max": 40 } } },
    "fs-hero": { "$type": "dimension", "$value": "clamp(2.4rem, 6vw, 4.25rem)", "$extensions": { "flutter": { "min": 38.4, "max": 68 } } },
    "lh-tight": { "$type": "number", "$value": 1.08 },
    "lh-snug": { "$type": "number", "$value": 1.25 },
    "lh-body": { "$type": "number", "$value": 1.65 },
    "space": {
      "1": { "$type": "dimension", "$value": "0.25rem" },
      "2": { "$type": "dimension", "$value": "0.5rem" },
      "3": { "$type": "dimension", "$value": "0.75rem" },
      "4": { "$type": "dimension", "$value": "1rem" },
      "5": { "$type": "dimension", "$value": "1.5rem" },
      "6": { "$type": "dimension", "$value": "2rem" },
      "7": { "$type": "dimension", "$value": "3rem" },
      "8": { "$type": "dimension", "$value": "4.5rem" },
      "9": { "$type": "dimension", "$value": "6.5rem" }
    },
    "radius-sm": { "$type": "dimension", "$value": "0.5rem" },
    "radius-md": { "$type": "dimension", "$value": "0.75rem" },
    "radius-lg": { "$type": "dimension", "$value": "1.25rem" },
    "shadow-soft": {
      "$type": "shadow",
      "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "40px", "color": "rgba(15, 31, 26, 0.06)" }
    },
    "shadow-lift": {
      "$type": "shadow",
      "$value": { "offsetX": "0px", "offsetY": "18px", "blur": "50px", "color": "rgba(14, 159, 110, 0.12)" }
    },
    "container": { "$type": "dimension", "$value": "1120px", "$extensions": { "flutter": false } },
    "header-h": { "$type": "dimension", "$value": "4.25rem", "$extensions": { "flutter": false } },
    "ease": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "dur": { "$type": "duration", "$value": "420ms" },
    "key-white": { "$type": "color", "$value": "#ffffff" },
    "key-black": { "$type": "color", "$value": "#1b2622" },
    "key-lit": { "$type": "color", "$value": "#a7f3d0" },
    "key-lit-black": { "$type": "color", "$value": "#10b981" },
    "key-line": { "$type": "color", "$value": "#c3d1cb" }
  },
  "c": {
    "r": { "$type": "color", "$value": "#10b981" },
    "r-soft": { "$type": "color", "$value": "#a7f3d0" },
    "t": { "$type": "color", "$value": "#f59e0b" },
    "t-soft": { "$type": "color", "$value": "#fde68a" },
    "f": { "$type": "color", "$value": "#3b82f6" },
    "f-soft": { "$type": "color", "$value": "#bfdbfe" },
    "s": { "$type": "color", "$value": "#a855f7" },
    "s-soft": { "$type": "color", "$value": "#e9d5ff" }
  },
  "animation": {
    "loading": {
      "cycle": { "$type": "duration", "$value": "4000ms" },
      "height": { "$type": "dimension", "$value": "48px" }
    }
  }
}
